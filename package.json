{
    "name": "geo-game",
    "version": "1.0.0",
    "main": "expo-router/entry",
    "dependencies": {
        "@expo-google-fonts/fredoka": "^0.4.1",
        "@expo-google-fonts/nunito": "^0.4.2",
        "@react-native-async-storage/async-storage": "2.2.0",
        "expo": "^58.0.19",
        "expo-constants": "~58.0.13",
        "expo-linear-gradient": "~58.0.3",
        "expo-linking": "~58.0.14",
        "expo-location": "~58.0.19",
        "expo-notifications": "~58.1.6",
        "expo-router": "~58.0.26",
        "expo-secure-store": "~58.0.2",
        "expo-status-bar": "~58.0.4",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-native": "0.88.0",
        "react-native-safe-area-context": "~5.10.1",
        "react-native-screens": "~4.30.0",
        "react-native-svg": "15.16.0",
        "react-native-webview": "14.0.1",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@iconify-json/game-icons": "^1.2.4",
        "@maplibre/maplibre-gl-style-spec": "^26.4.4",
        "@types/react": "~19.3.0",
        "eslint": "^9.0.0",
        "eslint-config-expo": "~58.0.4",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3"
    },
    "scripts": {
        "start": "node scripts/dev.mjs",
        "tunnel": "node scripts/dev.mjs --tunnel",
        "android": "node scripts/dev.mjs --android",
        "ios": "node scripts/dev.mjs --ios",
        "lint": "expo lint",
        "validate:map": "tsx scripts/validate-map-style.ts",
        "typecheck": "tsc --noEmit",
        "doctor": "expo-doctor",
        "icons": "node scripts/generate-icons.mjs",
        "sprites": "node scripts/generate-sprites.mjs",
        "sprite:add": "node scripts/add-sprite.mjs",
        "layer:add": "node scripts/add-layer.mjs",
        "item-art": "node scripts/generate-item-art.mjs",
        "assets": "node scripts/generate-assets.mjs",
        "sync:contracts": "node scripts/sync-geo-contracts.mjs",
        "check": "node scripts/sync-geo-contracts.mjs --check && node scripts/generate-assets.mjs --check && tsc --noEmit && expo lint"
    },
    "private": true
}
